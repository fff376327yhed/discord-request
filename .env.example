# Discord 개발자 포털에서 확인
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# (선택) 테스트 서버 ID. 넣으면 명령어가 즉시 반영됩니다.
DISCORD_GUILD_ID=

# Upstash Redis (Vercel에서 Upstash를 연결하면 KV_REST_API_* 가 자동으로 들어옵니다)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (선택) 다음 의뢰까지 대기 시간(분). 기본 10. 테스트할 땐 1 추천
COOLDOWN_MINUTES=10
